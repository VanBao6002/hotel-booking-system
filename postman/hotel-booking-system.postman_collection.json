              "raw": "{\n  \"address\": \"Oceanfront Hotel\",\n  \"phoneNumber\": \"0281234567\",\n  \"locationName\": \"Bangkok\",\n  \"averageStar\": 4.5,\n  \"roomCount\": 120,\n  \"imageUrl\": \"https://example.com/hotel.jpg\",\n  \"isOnline\": true,\n  \"services\": [\"WiFi\", \"Breakfast\"]\n}"
