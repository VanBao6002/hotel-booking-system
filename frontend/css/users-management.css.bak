/* Admin Users Management - Action Buttons and Modal Styling */

/* Action buttons container in each table row */
.action-btn {
  padding: 6px 10px;
  border: none;
  border-radius: 4px;
  font-size: 12px;
  cursor: pointer;
  font-weight: 500;
  transition: all 0.2s ease;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.action-btn:hover {
  transform: translateY(-1px);
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
}

.action-btn:active {
  transform: translateY(0);
}

/* Delete button - Red */
.action-delete {
  background: #e63946;
  color: white;
}

.action-delete:hover {
  background: #d62828;
}

/* Ban button - Orange */
.action-ban {
  background: #f77f00;
  color: white;
}

.action-ban:hover {
  background: #e07600;
}

/* Warn button - Yellow/Amber */
.action-warn {
  background: #fcbf49;
  color: #333;
}

.action-warn:hover {
  background: #f4a030;
}

/* Promote button - Green */
.action-promote {
  background: #06d6a0;
  color: white;
}

.action-promote:hover {
  background: #05c897;
}

/* Row status feedback messages */
.row-status {
  display: inline-block;
  padding: 4px 8px;
  border-radius: 3px;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.3px;
  animation: slideIn 0.3s ease;
}

.row-status.loading { 
  background: #e3f2fd; 
  color: #1976d2; 
}

.row-status.success { 
  background: #dcfce7; 
  color: #166534; 
  animation: slideIn 0.3s ease, slideOut 4s ease 4s forwards; 
}

.row-status.error  { 
  background: #ffcdd2; 
  color: #c62828; 
  animation: slideIn 0.3s ease, slideOut 3s ease 3s forwards; 
}

/* Modal backdrop - semi-transparent overlay */
.modal-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  animation: fadeIn 0.2s ease;
}

/* Modal container - centered box */
.modal-container {
  background: white;
  border-radius: 8px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
  max-width: 400px;
  width: 90%;
  animation: slideUp 0.3s ease;
}

/* Modal header */
.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 20px;
  border-bottom: 1px solid #eee;
}

.modal-header h3 {
  margin: 0;
  font-size: 18px;
  color: #333;
}

/* Modal close button */
.modal-close {
  font-size: 28px;
  cursor: pointer;
  color: #999;
  transition: color 0.2s;
  line-height: 1;
}

.modal-close:hover {
  color: #333;
}

/* Modal body content */
.modal-body {
  padding: 20px;
}

.modal-body p {
  margin: 0 0 16px 0;
  color: #555;
  line-height: 1.5;
}

/* Form group in modal */
.form-group {
  margin-bottom: 16px;
}

.form-group label {
  display: block;
  margin-bottom: 6px;
  font-size: 13px;
  font-weight: 600;
  color: #333;
}

/* Input field in modal */
.form-input {
  width: 100%;
  padding: 8px 12px;
  border: 1px solid #ddd;
  border-radius: 4px;
  font-size: 13px;
  box-sizing: border-box;
  transition: border-color 0.2s;
}

.form-input:focus {
  outline: none;
  border-color: #2196f3;
  box-shadow: 0 0 0 3px rgba(33, 150, 243, 0.1);
}

/* Modal footer with buttons */
.modal-footer {
  display: flex;
  gap: 10px;
  justify-content: flex-end;
  padding: 16px 20px;
  border-top: 1px solid #eee;
  background: #f9f9f9;
}

/* Cancel button */
.btn-cancel {
  padding: 8px 16px;
  border: 1px solid #ddd;
  background: white;
  color: #333;
  border-radius: 4px;
  cursor: pointer;
  font-size: 13px;
  font-weight: 600;
  transition: all 0.2s;
}

.btn-cancel:hover {
  background: #f0f0f0;
  border-color: #999;
}

/* Confirm button */
.btn-confirm {
  padding: 8px 16px;
  border: none;
  background: #2196f3;
  color: white;
  border-radius: 4px;
  cursor: pointer;
  font-size: 13px;
  font-weight: 600;
  transition: all 0.2s;
}

.btn-confirm:hover {
  background: #1976d2;
  box-shadow: 0 2px 8px rgba(33, 150, 243, 0.3);
}

.btn-confirm:active {
  transform: scale(0.98);
}

/* Animations */
@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes slideUp {
  from {
    transform: translateY(20px);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

@keyframes slideIn {
  from {
    opacity: 0;
    transform: translateY(-5px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes slideOut {
  from {
    opacity: 1;
    transform: translateY(0);
  }
  to {
    opacity: 0;
    transform: translateY(-5px);
  }
}

/* Responsive - adjust button sizes on mobile */
@media (max-width: 768px) {
  .action-btn {
    padding: 4px 8px;
    font-size: 11px;
  }

  .modal-container {
    width: 95%;
    max-width: none;
  }
}

/* Chỉnh cỡ chữ cho tiêu đề */
.users-management__container h2 {
    font-size: 24px !important;
}

/* Chỉnh cỡ chữ cho nội dung bảng */
.users-management__tbody td {
    font-size: 14px;
    color: #333;
}

/* Chỉnh cỡ chữ cho hàng tiêu đề bảng */
table thead th {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}